---
import type { CollectionEntry } from 'astro:content';
import { markdownHref } from '../../lib/path';
import Icon from '../ui/Icon.astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  headline?: string;
}

const { entry, headline } = Astro.props;
const { title, description } = entry.data;
---

<header class="page-header">
  {headline && <p class="headline">{headline}</p>}
  <div class="title-row">
    <h1>{title}</h1>
    <button
      class="copy"
      type="button"
      aria-label="Copy page as Markdown"
      title="Copy page as Markdown"
      data-copy-page={markdownHref(entry.id)}
      data-pagefind-ignore
    >
      <Icon name="copy" class="copy-icon" />
      <Icon name="check" class="check-icon" />
    </button>
  </div>
  {description && <p class="description">{description}</p>}
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-page]').forEach((button) => {
    button.addEventListener('click', async () => {
      const response = await fetch(button.dataset.copyPage!);
      await navigator.clipboard.writeText(await response.text());
      button.toggleAttribute('data-copied', true);
      setTimeout(() => button.removeAttribute('data-copied'), 1500);
    });
  });
</script>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .headline {
    margin-bottom: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .description {
    margin-top: 0.5rem;
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }

  .copy {
    flex-shrink: 0;
    color: var(--fg-subtle);
    transition: color var(--duration);
  }

  .copy:hover,
  .copy[data-copied] {
    color: var(--fg);
  }

  .copy :global(.check-icon),
  .copy[data-copied] :global(.copy-icon) {
    display: none;
  }

  .copy[data-copied] :global(.check-icon) {
    display: block;
  }
</style>
