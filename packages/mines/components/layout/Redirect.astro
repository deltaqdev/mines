---
interface Props {
  to: string;
}

const { to } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <title>Redirecting</title>
    <script is:inline define:vars={{ to }}>
      location.replace(to);
    </script>
  </head>
  <body></body>
</html>
