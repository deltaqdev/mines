---
interface Props {
  labels: string[];
}

const { labels } = Astro.props;
---

<div class="tablist" role="tablist">
  {
    labels.map((label, index) => (
      <button type="button" role="tab" data-tab={index} aria-selected={String(index === 0)}>
        {label}
      </button>
    ))
  }
  <slot />
</div>

<style>
  .tablist {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0 0.375rem;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  button {
    position: relative;
    flex-shrink: 0;
    height: 2.25rem;
    padding: 0 0.625rem;
    font-size: var(--text-sm);
    color: var(--fg-subtle);
    transition: color var(--duration);
  }

  button:hover {
    color: var(--fg);
  }

  button[aria-selected='true'] {
    color: var(--fg);
  }

  button[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset: auto 0.625rem 0;
    height: 1px;
    background: var(--accent);
  }
</style>
