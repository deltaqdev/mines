---
import Icon from './Icon.astro';
---

<button class="trigger" type="button" data-search-open>
  <Icon name="search" size={14} />
  <span class="label">Search</span>
  <kbd>⌘K</kbd>
</button>

<dialog class="dialog" aria-label="Search" data-search-dialog>
  <div class="field">
    <Icon name="search" size={14} />
    <input type="search" placeholder="Search docs" autocomplete="off" spellcheck="false" data-search-input />
    <kbd>Esc</kbd>
  </div>
  <ul class="results" role="listbox" data-search-results></ul>
  <p class="status" data-search-status></p>
</dialog>

<script>
  import { withBase } from '../../lib/path';

  interface PagefindResult {
    url: string;
    excerpt: string;
    meta: { title: string };
  }

  interface Pagefind {
    options(options: object): Promise<void>;
    debouncedSearch(query: string): Promise<{ results: { data(): Promise<PagefindResult> }[] } | null>;
  }

  const MAX_RESULTS = 8;

  // Pagefind only exists in the build output, so the import is hidden from Vite's bundler.
  const importAtRuntime = new Function('url', 'return import(url)') as (url: string) => Promise<Pagefind>;

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
  const status = dialog.querySelector<HTMLParagraphElement>('[data-search-status]')!;

  let pagefind: Promise<Pagefind | undefined> | undefined;
  let active = 0;

  function loadPagefind() {
    return (pagefind ??= importAtRuntime(withBase('pagefind/pagefind.js'))
      .then(async (module) => {
        await module.options({ baseUrl: withBase('/'), excerptLength: 16 });
        return module;
      })
      .catch(() => undefined));
  }

  function open() {
    dialog.showModal();
    input.select();
    loadPagefind();
  }

  function renderResult(result: PagefindResult) {
    const item = document.createElement('li');
    const link = document.createElement('a');
    const title = document.createElement('span');
    const excerpt = document.createElement('span');

    item.role = 'option';
    link.href = result.url;
    title.className = 'result-title';
    title.textContent = result.meta.title;
    excerpt.className = 'result-excerpt';
    excerpt.innerHTML = result.excerpt;

    link.append(title, excerpt);
    item.append(link);
    return item;
  }

  function setActive(index: number) {
    const items = [...list.children];
    if (!items.length) return;
    active = (index + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  async function search(query: string) {
    const module = await loadPagefind();
    if (!module) {
      status.textContent = 'Search is available after running a build.';
      return;
    }

    const response = await module.debouncedSearch(query);
    if (!response) return;

    const results = await Promise.all(response.results.slice(0, MAX_RESULTS).map((result) => result.data()));
    list.replaceChildren(...results.map(renderResult));
    status.textContent = query && !results.length ? 'No results.' : '';
    setActive(0);
  }

  input.addEventListener('input', () => search(input.value.trim()));

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') setActive(active + 1);
    else if (event.key === 'ArrowUp') setActive(active - 1);
    else if (event.key === 'Enter') list.children[active]?.querySelector('a')?.click();
    else return;
    event.preventDefault();
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.querySelector('[data-search-open]')!.addEventListener('click', open);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'k' && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      if (dialog.open) dialog.close();
      else open();
    }
  });
</script>

<style>
  .trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 16rem;
    height: 2rem;
    padding: 0 0.375rem 0 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg-subtle);
    font-size: var(--text-sm);
    transition: border-color var(--duration);
  }

  .trigger:hover {
    border-color: var(--border-strong);
  }

  .label {
    flex: 1;
    text-align: left;
  }

  kbd {
    padding: 0 0.3125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    line-height: 1.125rem;
    color: var(--fg-subtle);
  }

  .dialog {
    width: min(36rem, calc(100% - 2rem));
    max-height: min(28rem, calc(100% - 8rem));
    margin: 6rem auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 16px 48px -12px rgb(0 0 0 / 0.25);
    overflow: hidden;
  }

  .dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .dialog::backdrop {
    background: rgb(0 0 0 / 0.3);
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--fg-subtle);
  }

  input {
    flex: 1;
    height: 2.75rem;
    border: 0;
    outline: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: var(--text-base);
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .results {
    list-style: none;
    padding: 0.375rem;
    overflow-y: auto;
  }

  .results:empty {
    display: none;
  }

  .results :global(a) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius);
  }

  .results :global([aria-selected='true'] a) {
    background: var(--bg-muted);
  }

  .results :global(.result-title) {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .results :global(.result-excerpt) {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }

  .results :global(mark) {
    background: none;
    color: var(--accent);
  }

  .status {
    padding: 0.75rem;
    font-size: var(--text-sm);
    color: var(--fg-subtle);
  }

  .status:empty {
    display: none;
  }

  @media (max-width: 48rem) {
    .trigger {
      width: 2rem;
      padding: 0;
      justify-content: center;
      border: 0;
      background: none;
    }

    .trigger .label,
    .trigger kbd {
      display: none;
    }
  }
</style>
