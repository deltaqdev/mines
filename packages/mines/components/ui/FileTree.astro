---
import type { TreeNode } from '../../lib/tree';
import Icon from './Icon.astro';

interface Props {
  nodes: TreeNode[];
}

const { nodes } = Astro.props;
---

<ul class="file-tree">
  {
    nodes.map((node) => (
      <li>
        {node.index === undefined ? (
          <details open>
            <summary>
              <Icon name="folder" size={13} />
              {node.name}
            </summary>
            <Astro.self nodes={node.children} />
          </details>
        ) : (
          <button type="button" data-tab={node.index} aria-selected={String(node.index === 0)}>
            <Icon name="file" size={13} />
            {node.name}
          </button>
        )}
      </li>
    ))
  }
</ul>

<style>
  .file-tree {
    list-style: none;
    min-width: max-content;
    padding: 0;
  }

  .file-tree :global(svg) {
    flex-shrink: 0;
  }

  .file-tree .file-tree {
    padding-left: 0.75rem;
  }

  summary,
  button {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    width: 100%;
    padding: 0.1875rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  button:hover {
    color: var(--fg);
    background: var(--bg-muted);
  }

  button[aria-selected='true'] {
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
