---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Header, Sidebar, PageHeader, Toc, Pager, Footer } from 'virtual:mines/components';
import config from 'virtual:mines/config';
import 'virtual:mines/styles';
import Head from '../components/layout/Head.astro';
import Scrollbar from '../components/layout/Scrollbar.astro';
import { getDocs } from '../lib/docs';
import { tocLinkGroups } from '../lib/links';
import { sectionOf, sidebarGroups, surroundingPages } from '../lib/navigation';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { entries, sections } = await getDocs();

const tocHeadings = entry.data.toc ? headings.filter((heading) => heading.depth <= 3) : [];
const section = sectionOf(sections, entry.id);
const groups = sidebarGroups(sections, entry.id);
const group = groups.find(({ pages }) => pages.some((page) => page.id === entry.id));
const headline = group?.title || section?.title;
const { prev, next } = surroundingPages(sections, entry.id);
const hasSubNav = config.subNav === 'header';
const tocLinks = tocLinkGroups(entry, entries);
---

<html lang="en" data-subnav={hasSubNav ? '' : undefined}>
  <Head entry={entry} />
  <body>
    <Header sections={hasSubNav ? sections : []} currentSection={section?.key} />
    <div class="shell container">
      <Sidebar groups={groups} currentId={entry.id} />
      <main class="main">
        <article data-pagefind-body>
          <PageHeader entry={entry} headline={headline} />
          <div class="prose">
            <slot />
          </div>
        </article>
        <Footer entry={entry} />
        <Pager prev={prev} next={next} />
      </main>
      <Toc headings={tocHeadings} links={tocLinks} />
    </div>
    <Scrollbar />
  </body>
</html>

<script>
  import '../scripts/code-copy';
  import '../scripts/scrollbars';
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--toc-width);
    gap: 3rem;
  }

  .main {
    width: 100%;
    max-width: var(--content-width);
    padding: 2rem 0 4rem;
  }

  @media (max-width: 75rem) {
    .shell {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
  }

  @media (max-width: 48rem) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .main {
      padding-top: 1.5rem;
    }
  }
</style>
